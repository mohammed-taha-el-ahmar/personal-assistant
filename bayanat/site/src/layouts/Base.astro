---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dir, t, type Lang } from '../i18n';
import { CF_BEACON, url } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of the same page in the other language, if it exists. */
  altPath?: string;
  current?: string;
}
const { lang, title, description, altPath, current } = Astro.props;
const s = t(lang);
const pageTitle = title ? `${title} · ${s.siteName}` : `${s.siteName} · ${s.heroTitle}`;
const desc = description ?? s.tagline;
const other: Lang = lang === 'en' ? 'ar' : 'en';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {altPath && <link rel="alternate" hreflang={other} href={new URL(url(altPath), Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=JetBrains+Mono:wght@500&family=Noto+Naskh+Arabic:wght@600;700&family=Noto+Sans+Arabic:wght@400;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#content">{lang === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}</a>
    <Header lang={lang} altPath={altPath} current={current} />
    <main id="content" class="wrap">
      <slot />
    </main>
    <Footer lang={lang} />
    {CF_BEACON && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_BEACON })}></script>
    )}
  </body>
</html>
