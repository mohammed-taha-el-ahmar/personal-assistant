---
import Base from '../../../layouts/Base.astro';
import AnalysisCard from '../../../components/AnalysisCard.astro';
import { LANGS, t, type Lang } from '../../../i18n';
import { analyses } from '../../../lib/content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);
const items = await analyses(lang);
const title = lang === 'en' ? 'Analysis' : 'التحليلات';
---
<Base lang={lang} title={title} altPath={`/${lang === 'en' ? 'ar' : 'en'}/analysis/`} current="analysis">
  <div class="section-head" style="border-top:0;padding-top:0"><h1 style="margin:0;font-size:36px">{title}</h1></div>
  {items.length === 0 ? <p class="empty">{s.analysisEmpty}</p> : (
    <div class="grid">
      {items.map((a) => (
        <AnalysisCard lang={lang} slug={a.id} title={a.data.title} description={a.data.description}
          pillar={a.data.pillar} minutes={a.data.reading_minutes} />
      ))}
    </div>
  )}
</Base>
