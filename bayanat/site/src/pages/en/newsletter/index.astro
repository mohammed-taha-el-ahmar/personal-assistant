---
import Base from '../../../layouts/Base.astro';
import Subscribe from '../../../components/Subscribe.astro';
import { formatDate, t } from '../../../i18n';
import { sentIssues } from '../../../lib/content';
import { url } from '../../../lib/site';

const s = t('en');
const issues = await sentIssues();
---
<Base lang="en" title={s.newsletterTitle} current="newsletter">
  <h1 style="margin:0;font-size:36px">{s.newsletterTitle}</h1>
  <div style="max-width:560px"><Subscribe lang="en" id="email-archive" /></div>
  <div class="section">
    {issues.length === 0 ? <p class="empty">{s.newsletterEmpty}</p> : (
      <ol class="list" style="max-width:760px">
        {issues.map((i) => (
          <li><span class="tag">#{i.data.issue} · {formatDate(i.data.date, 'en')}</span>
            <a href={url(`/en/newsletter/${i.data.issue}/`)}>{i.data.title}</a></li>
        ))}
      </ol>
    )}
  </div>
</Base>
