rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isHost() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validQuiz(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.questions is list && d.questions.size() > 0 && d.questions.size() <= 100;
    }

    match /quizzes/{quizId} {
      allow read, delete: if isHost() && resource.data.ownerUid == request.auth.uid;
      allow create: if isHost()
        && request.resource.data.ownerUid == request.auth.uid
        && validQuiz(request.resource.data);
      allow update: if isHost()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validQuiz(request.resource.data);
    }
  }
}
