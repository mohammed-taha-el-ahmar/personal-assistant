rules_version = '2';

// Security rules for Toastmasters Tools.
// Paste this file into Firebase console → Firestore Database → Rules, then Publish.
//
// Data layout, one space per club code:
//   clubs/{club}                  {officers: [emails], status, name, deletion?}  created by the Orato administrator on approval
//   requests/{club}               a request to open a club space; the requester and administrators read it
//   app/config, app/public        administrators' list (made in the console) and public contact address
//   clubs/{club}/history/{id}     archived meetings; officers only
//   clubs/{club}/meeting/roles    who holds each meeting role
//   clubs/{club}/meeting/agenda   the running order
//   clubs/{club}/meeting/vote     voting categories, nominees, reveal flag, who launched the vote (by, byName)
//   clubs/{club}/meeting/reports  reports sent by the Timer, Ah-Counter and Grammarian
//   clubs/{club}/meeting/draw     the latest random speaking order
//   clubs/{club}/ballots/{uid}    one ballot per device; only that device can write it
//   clubs/{club}/feedback/{id}    meeting feedback from members and guests; officers read it
//   clubs/{club}/public/info      the club introduction page; everyone reads, officers edit
//   clubs/{club}/public/status    deletion notice shown to every member; officers write it
//   clubs/{club}/public/modules   which sections and tabs the club shows; officers choose
//   clubs/{club}/interest/{uid}   members interested in an officer role; the sender and officers read it
//   clubs/{club}/templates/{id}   agenda templates; everyone reads, officers create, update and delete
//   clubs/{club}/private/config   {memberCode, v, guestsVote}  the club code; officers only
//   clubs/{club}/public/access    {on, v, guestsVote}  repeats whether member access is on, for every page
//   clubs/{club}/media/{id}       club page photos (small and large versions); everyone reads, officers write
//   clubs/{club}/guestbook/{id}   guests signed in at meetings; anyone creates, officers read
//   clubs/{club}/members/{id}     member list and renewals; officers only
//   clubs/{club}/devices/{uid}    one per device unlocked with the club code; valid while its v matches the config
//
// Permission levels, once officers have turned on member access (private/config exists):
//   visitor (link only)          read, vote (unless guestsVote is false), feedback, interest form
//   member  (device unlocked)    + take a free role or give up their own, send reports
//   officer (on the officer list) + agenda, nominees and results, draw, anyone's roles, everything else
// Without private/config the club stays open as before: everyone with the link can edit the meeting.
//
// Members are signed in anonymously. Officers sign in with Google and are recognised by their verified email.
//
// Deleting a club: an officer sets clubs/{club}.deletion = {requestedAt: <server time>, requestedBy}.
// The time is checked against the server clock, so the 3-day delay cannot be shortened. During those 3 days
// any officer can cancel, and the officer list cannot shrink. Once the delay has passed, the club is locked:
// nobody can read or write it any more, except officers, who may only read and delete in order to erase it.

service cloud.firestore {
  match /databases/{database}/documents {

    function validClub(club) {
      return club.matches('^[a-z0-9-]{3,40}$');
    }
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function clubPath(club) {
      return /databases/$(database)/documents/clubs/$(club);
    }
    function isOfficer(club) {
      return hasVerifiedEmail()
        && exists(clubPath(club))
        && myEmail() in get(clubPath(club)).data.officers;
    }
    // True once a requested deletion has waited its 3 days.
    function deletionDue(club) {
      return exists(clubPath(club))
        && get(clubPath(club)).data.get('deletion', null) != null
        && request.time > get(clubPath(club)).data.deletion.requestedAt + duration.value(3, 'd');
    }
    // ----- Orato administrators and club approval -----
    // app/config {admins: [emails]} is created by hand in the Firebase console (see the README).
    function appConfigPath() {
      return /databases/$(database)/documents/app/config;
    }
    function isAppAdmin() {
      return hasVerifiedEmail() && exists(appConfigPath()) && myEmail() in get(appConfigPath()).data.admins;
    }
    // A club space works only once the administrator has approved it (clubs created before approvals existed
    // have no status and count as approved). A suspended club is closed until it is reactivated.
    function approved(club) {
      return exists(clubPath(club)) && get(clubPath(club)).data.get('status', 'approved') == 'approved';
    }
    function open(club) {
      return validClub(club) && approved(club) && !deletionDue(club);
    }
    // ----- member access -----
    function cfgPath(club) {
      return /databases/$(database)/documents/clubs/$(club)/private/config;
    }
    function devPath(club) {
      return /databases/$(database)/documents/clubs/$(club)/devices/$(request.auth.uid);
    }
    function protectedClub(club) {
      return exists(cfgPath(club));
    }
    // A device unlocked with the current code (changing the code raises v and revokes older devices).
    function memberDevice(club) {
      return exists(devPath(club)) && get(devPath(club)).data.v == get(cfgPath(club)).data.v;
    }
    // Officer level: edit the meeting. Everyone, while the club has not turned on member access.
    function canManage(club) {
      return request.auth != null && (!protectedClub(club) || isOfficer(club));
    }
    // Member level: take your own role, send reports.
    function memberLevel(club) {
      return canManage(club) || (request.auth != null && memberDevice(club));
    }
    function canVote(club) {
      return request.auth != null
        && (!protectedClub(club) || get(cfgPath(club)).data.get('guestsVote', true) == true || memberLevel(club));
    }
    // A member changes one role (named in "edit"): takes it while it is free, or gives up their own.
    function memberRoleEdit() {
      let k = request.resource.data.get('edit', '');
      let oldR = resource == null ? {} : resource.data.get('roles', {});
      let newR = request.resource.data.get('roles', {});
      let before = oldR.get(k, null);
      let after = newR.get(k, null);
      return k is string && k.matches('^[a-z0-9]{1,20}$')
        && newR is map
        && (resource == null
          ? request.resource.data.keys().hasOnly(['roles', 'edit'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'edit']))
        && newR.diff(oldR).affectedKeys().hasOnly([k])
        && (
          // take a free role, under your own device id
          ((before == null || (before is map && before.get('n', '') == ''))
            && after is map && after.keys().hasOnly(['n', 'u'])
            && after.u == request.auth.uid && after.n is string && after.n.size() > 0 && after.n.size() <= 60)
          // give up a role you took
          || (before is map && before.get('u', '') == request.auth.uid && after == null)
        );
    }

    // Voting: a vote belongs to whoever launched it ("by") until its results are shown ("reveal").
    // While it runs, only that person (or an officer) may change it. Anyone else who changes the vote document
    // must have waited for the results, and becomes the owner of the next vote.
    function voteControl() {
      let owner = resource == null ? '' : resource.data.get('by', '');
      let revealed = resource == null ? true : resource.data.get('reveal', false);
      return (owner == '' || owner == request.auth.uid || revealed == true)
        && request.resource.data.get('by', '') == request.auth.uid
        && request.resource.data.get('byName', '') is string && request.resource.data.get('byName', '').size() <= 60;
    }

    // Officers erasing a club whose delay has passed.
    function purging(club) {
      return validClub(club) && isOfficer(club) && deletionDue(club);
    }

    // The club and its officer list. Only the Orato administrator creates a club, when approving a request, with the
    // requester as first officer. Officers see and change the officer list; the administrator suspends or reactivates.
    // Anyone signed in with a verified email may check whether a club exists (empty read).
    match /clubs/{club} {
      allow get: if validClub(club) && hasVerifiedEmail()
        && (resource == null || myEmail() in resource.data.officers || isAppAdmin());
      allow list: if isAppAdmin();
      allow create: if validClub(club) && isAppAdmin()
        && request.resource.data.keys().hasOnly(['officers', 'status', 'name', 'approvedAt', 'approvedBy'])
        && request.resource.data.officers is list
        && request.resource.data.officers.size() >= 1 && request.resource.data.officers.size() <= 20
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedBy == myEmail();
      allow update: if isAppAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'statusBy'])
        && request.resource.data.status in ['approved', 'suspended'];
      allow update: if isOfficer(club) && approved(club) && !deletionDue(club)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['officers', 'deletion'])
        && request.resource.data.officers is list
        && request.resource.data.officers.size() >= 1
        && request.resource.data.officers.size() <= 20
        && (
          // Ordinary change (officer list). While a deletion is pending, officers can be added but not removed,
          // so nobody can lock the others out before the deletion happens.
          (request.resource.data.get('deletion', null) == resource.data.get('deletion', null)
            && (resource.data.get('deletion', null) == null || request.resource.data.officers.hasAll(resource.data.officers)))
          // Request the deletion: stamped with the server time, officer list unchanged.
          || (resource.data.get('deletion', null) == null
            && request.resource.data.deletion.keys().hasOnly(['requestedAt', 'requestedBy'])
            && request.resource.data.deletion.requestedAt == request.time
            && request.resource.data.deletion.requestedBy == myEmail()
            && request.resource.data.officers == resource.data.officers)
          // Cancel the deletion (any officer, before the delay has passed).
          || (resource.data.get('deletion', null) != null
            && request.resource.data.get('deletion', null) == null
            && request.resource.data.officers == resource.data.officers)
        );
      allow delete: if purging(club);
    }

    // Requests to open a club space, one per club code. The requester (verified email) creates it while the code is
    // free, reads it, cancels it, and may send it again after a refusal. The administrator reads, decides and deletes.
    function validRequest(club) {
      let d = request.resource.data;
      return d.keys().hasOnly(['club', 'name', 'city', 'tiNumber', 'role', 'message', 'email', 'lang', 'at', 'status'])
        && d.club == club && d.email == myEmail() && d.status == 'pending'
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.city is string && d.city.size() <= 120
        && d.tiNumber is string && d.tiNumber.size() <= 20
        && d.role is string && d.role.size() <= 20
        && d.message is string && d.message.size() <= 1000;
    }
    match /requests/{club} {
      allow get: if validClub(club) && hasVerifiedEmail()
        && (resource == null || resource.data.email == myEmail() || isAppAdmin());
      allow list: if isAppAdmin();
      allow create: if validClub(club) && hasVerifiedEmail() && !exists(clubPath(club)) && validRequest(club);
      allow update: if validClub(club) && hasVerifiedEmail() && !exists(clubPath(club))
        && resource.data.email == myEmail() && resource.data.status == 'rejected' && validRequest(club);
      allow update: if isAppAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.get('reason', '') is string && request.resource.data.get('reason', '').size() <= 300;
      allow delete: if isAppAdmin()
        || (hasVerifiedEmail() && resource.data.email == myEmail() && resource.data.status != 'approved')
        // once a club has been erased, its old request can be removed so the code can be requested again
        || (hasVerifiedEmail() && !exists(clubPath(club)) && resource.data.status == 'approved');
    }

    // app/config: the administrators (created in the console, read only by them).
    // app/public: the contact address shown to requesters and the support button (everyone reads, administrators write).
    match /app/{docId} {
      allow get: if docId == 'public' || (docId == 'config' && isAppAdmin());
      allow create, update: if docId == 'public' && isAppAdmin()
        && request.resource.data.keys().hasOnly(['contact', 'support', 'updatedAt'])
        && request.resource.data.get('contact', '') is string && request.resource.data.get('contact', '').size() <= 120
        // support button: {show, url (https), label, header}
        && (!('support' in request.resource.data) || (
          request.resource.data.support.keys().hasOnly(['show', 'url', 'label', 'header'])
          && request.resource.data.support.show is bool && request.resource.data.support.header is bool
          && request.resource.data.support.url is string && request.resource.data.support.url.size() <= 300
          && (request.resource.data.support.url == '' || request.resource.data.support.url.matches('^https://[^ ]+$'))
          && request.resource.data.support.label is string && request.resource.data.support.label.size() <= 40));
    }

    match /clubs/{club}/history/{meetingId} {
      allow read, create, update, delete: if open(club) && isOfficer(club);
      allow read, delete: if purging(club);
    }

    // Meeting feedback: anyone with the club link (members and guests, signed in anonymously) may send one answer
    // per device and meeting (the document id is "<date>_<their uid>", and answers cannot be changed).
    // Only officers can read or delete answers.
    match /clubs/{club}/feedback/{answerId} {
      allow create: if request.auth != null
        && open(club)
        && answerId == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['date', 'kind', 'rating', 'likes', 'again', 'comment', 'name', 'email', 'contact', 'publishOk', 'lang', 'at'])
        && request.resource.data.get('publishOk', false) is bool
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.kind in ['member', 'guest']
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.likes is list && request.resource.data.likes.size() <= 8
        && request.resource.data.again in ['', 'yes', 'maybe', 'no']
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.contact is bool;
      allow read, delete: if validClub(club) && isOfficer(club);
      allow update: if false;
    }

    // Club introduction page (info) and deletion notice (status): everyone reads, officers write.
    // The status stays readable after the delay so members see that the club space was deleted.
    match /clubs/{club}/public/{docId} {
      allow read: if validClub(club) && (docId == 'status' || !deletionDue(club));
      allow write: if open(club) && docId in ['info', 'status', 'modules', 'access'] && isOfficer(club);
      allow delete: if purging(club);
    }

    // "Interested in joining the officers": one form per device. The sender can read and update their own answer
    // (but not the follow-up status); officers read all answers, set the status and delete.
    match /clubs/{club}/interest/{uid} {
      allow get: if open(club) && request.auth != null && request.auth.uid == uid;
      allow read, delete: if validClub(club) && isOfficer(club);
      allow create, update: if open(club) && request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'roles', 'when', 'message', 'at', 'lang', 'status'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.roles is list && request.resource.data.roles.size() <= 10
        && request.resource.data.when in ['now', 'next', 'either']
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && (!('status' in request.resource.data) || (resource != null && 'status' in resource.data && request.resource.data.status == resource.data.status));
      allow update: if open(club) && isOfficer(club)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'contacted', 'offered', 'joined', 'declined'];
    }

    // Guest book: anyone with the club link signs in a guest (one device can sign in several guests, each entry
    // id is "<date>_<their uid>_<random>"). Entries cannot be changed by guests. Officers read them, set the
    // follow-up status and delete them.
    match /clubs/{club}/guestbook/{entryId} {
      allow create: if request.auth != null && open(club)
        && entryId.matches(request.resource.data.date + '_' + request.auth.uid + '_[a-z0-9]{1,12}')
        && request.resource.data.keys().hasOnly(['date', 'name', 'email', 'phone', 'heard', 'first', 'news', 'join', 'lang', 'at'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.heard in ['', 'friend', 'web', 'social', 'event', 'work', 'other']
        && request.resource.data.first in ['first', 'again']
        && request.resource.data.news is bool && request.resource.data.join is bool;
      allow read, delete: if validClub(club) && isOfficer(club);
      allow update: if open(club) && isOfficer(club)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'contacted', 'member', 'done'];
    }

    // Club page photos, resized in the browser: "<id>" is the small version, "<id>-full" the large one.
    // Everyone reads them with the club page; officers add and delete them.
    match /clubs/{club}/media/{mediaId} {
      allow read: if validClub(club) && (!deletionDue(club) || purging(club));
      allow create, update: if open(club) && isOfficer(club)
        && mediaId.matches('^[a-z0-9]{6,20}(-full)?$')
        && request.resource.data.keys().hasOnly(['data', 'w', 'h', 'at', 'by'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 750000
        && request.resource.data.w is int && request.resource.data.h is int;
      allow delete: if validClub(club) && isOfficer(club);
    }

    // Member list with renewals: officers only.
    match /clubs/{club}/members/{memberId} {
      allow read, delete: if validClub(club) && isOfficer(club);
      allow create, update: if open(club) && isOfficer(club)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'joined', 'tmId', 'status', 'notes', 'renewals', 'source', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 40
        && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 1000
        && request.resource.data.get('status', 'active') in ['active', 'former']
        && request.resource.data.get('renewals', {}) is map && request.resource.data.get('renewals', {}).size() <= 60;
    }

    // Agenda templates: everyone with the club link can use them, only officers manage them.
    match /clubs/{club}/templates/{templateId} {
      allow read: if open(club) || purging(club);
      allow delete: if validClub(club) && isOfficer(club);
      allow create, update: if open(club) && isOfficer(club)
        && request.resource.data.keys().hasOnly(['name', 'items', 'start', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 40;
    }

    // The club code. Only officers read or change it; v only grows, so a code that was replaced never works again.
    match /clubs/{club}/private/{docId} {
      allow read: if docId == 'config' && validClub(club) && isOfficer(club);
      allow create, update: if docId == 'config' && open(club) && isOfficer(club)
        && request.resource.data.keys().hasOnly(['memberCode', 'v', 'guestsVote', 'updatedAt', 'updatedBy'])
        && request.resource.data.memberCode is string && request.resource.data.memberCode.matches('^[A-Z0-9]{6,32}$')
        && request.resource.data.v is int
        && (resource == null || request.resource.data.v >= resource.data.v)
        && request.resource.data.guestsVote is bool;
      allow delete: if docId == 'config' && validClub(club) && isOfficer(club);
    }

    // Unlocked devices. A device registers itself with the current code and version; it can read and forget
    // its own record. Officers list them and can remove any.
    match /clubs/{club}/devices/{uid} {
      allow get: if validClub(club) && request.auth != null && request.auth.uid == uid;
      allow create, update: if open(club) && request.auth != null && request.auth.uid == uid
        && protectedClub(club)
        && request.resource.data.keys().hasOnly(['code', 'v', 'name', 'at'])
        && request.resource.data.code == get(cfgPath(club)).data.memberCode
        && request.resource.data.v == get(cfgPath(club)).data.v
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60;
      allow delete: if validClub(club) && request.auth != null && request.auth.uid == uid;
      allow read, delete: if validClub(club) && isOfficer(club);
    }

    // The current meeting. Agenda, voting setup and draw: officer level. Reports: member level.
    // Roles: officer level for any change; member level to take a free role or give up one's own.
    match /clubs/{club}/meeting/{docId} {
      allow read: if open(club) || purging(club);
      allow create, update: if request.auth != null
        && open(club)
        && docId in ['roles', 'agenda', 'vote', 'reports', 'draw']
        && request.resource.data.keys().size() <= 10
        && ((docId != 'vote' && canManage(club))
          || (docId == 'vote' && (isOfficer(club) || (memberLevel(club) && voteControl())))
          || (docId == 'reports' && memberLevel(club))
          || (docId == 'roles' && memberLevel(club) && memberRoleEdit()));
      allow delete: if purging(club);
    }

    match /clubs/{club}/ballots/{voterId} {
      allow read: if open(club) || purging(club);
      allow create, update: if request.auth != null
        && request.auth.uid == voterId
        && open(club)
        && request.resource.data.keys().size() <= 20
        && canVote(club);
      allow delete: if purging(club);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
