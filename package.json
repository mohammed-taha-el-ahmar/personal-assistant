{
  "name": "personal-assistant",
  "private": true,
  "type": "module",
  "description": "Recruiter assistant website (GitHub Pages) + Groq proxy (Cloudflare Worker)",
  "scripts": {
    "dev": "npx --yes serve -l 5173 .",
    "build:content": "node scripts/build-content.mjs",
    "check:content": "node scripts/build-content.mjs --check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "worker:dev": "npm run build:content && wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "npm run build:content && wrangler deploy --config worker/wrangler.toml",
    "test": "node --test 'worker/test/*.test.js' 'scripts/lib/*.test.mjs'",
    "worker:bundle": "npm run build:content && esbuild worker/src/index.js --bundle --format=esm --platform=neutral --target=es2022 --outfile=worker/dist/worker.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "wrangler": "^4.0.0"
  }
}
